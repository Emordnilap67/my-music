<?xml version="1.0" encoding="utf-8"?>
<!-- MY MUSIC widget, the smaller card (about 4 x 2): the neon card. Every part is sized by weights from
     the widget's real size (no sizes from the launcher needed), the edge is nine pieces drawn
     in the song's colours (NeonArt.frame: corners keep their shape at any size), texts size
     themselves. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/w_plain" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_margin="4dp" android:src="@drawable/widget_neon_bg" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:id="@+id/w_frame" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="29dp" android:orientation="horizontal">
            <ImageView android:id="@+id/w_f_tl" android:layout_width="29dp" android:layout_height="29dp" android:scaleType="fitXY" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/w_f_t" android:layout_width="0dp" android:layout_height="29dp" android:layout_weight="1" android:scaleType="fitXY" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/w_f_tr" android:layout_width="29dp" android:layout_height="29dp" android:scaleType="fitXY" android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <ImageView android:id="@+id/w_f_l" android:layout_width="29dp" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no" />
            <FrameLayout android:id="@+id/w_center" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#F407050D" />
            <ImageView android:id="@+id/w_f_r" android:layout_width="29dp" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="29dp" android:orientation="horizontal">
            <ImageView android:id="@+id/w_f_bl" android:layout_width="29dp" android:layout_height="29dp" android:scaleType="fitXY" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/w_f_b" android:layout_width="0dp" android:layout_height="29dp" android:layout_weight="1" android:scaleType="fitXY" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/w_f_br" android:layout_width="29dp" android:layout_height="29dp" android:scaleType="fitXY" android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/w_inner" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
        android:paddingStart="20dp" android:paddingTop="19dp" android:paddingEnd="22dp" android:paddingBottom="9dp">
        <LinearLayout android:id="@+id/w_main" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="419" android:orientation="horizontal" android:baselineAligned="false">
            <ImageView android:id="@+id/w_art" android:layout_width="wrap_content" android:layout_height="match_parent"
                android:adjustViewBounds="true" android:maxWidth="130dp" android:scaleType="fitCenter" android:src="@mipmap/ic_launcher_fg" android:contentDescription="Open MY MUSIC" />
            <LinearLayout android:id="@+id/w_text" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:layout_marginStart="12dp" android:orientation="vertical">
                <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="26" />
                <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="79"
                    android:text="MY MUSIC" android:textColor="#FFFFFFFF" android:textSize="24sp" android:textStyle="bold" android:fontFamily="sans-serif"
                    android:maxLines="1" android:ellipsize="end" android:gravity="start|center_vertical"
                    android:autoSizeTextType="uniform" android:autoSizeMinTextSize="15sp" android:autoSizeMaxTextSize="44sp" android:autoSizeStepGranularity="1sp" />
                <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="8" />
                <TextView android:id="@+id/w_artist" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="40"
                    android:text="Tap play to start" android:textColor="#FFB9B8C6" android:textSize="15sp" android:fontFamily="sans-serif"
                    android:maxLines="1" android:ellipsize="end" android:gravity="start|center_vertical"
                    android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="24sp" android:autoSizeStepGranularity="1sp" />
                <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="20" />
                <FrameLayout android:id="@+id/w_barbox" android:layout_width="match_parent" android:layout_height="16dp">
                    <ImageView android:id="@+id/w_track" android:layout_width="match_parent" android:layout_height="10dp" android:layout_gravity="center_vertical"
                        android:layout_marginStart="7dp" android:layout_marginEnd="7dp" android:scaleType="fitXY" android:src="@drawable/widget_track" android:importantForAccessibility="no" />
                    <ProgressBar android:id="@+id/w_prog" style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent" android:layout_height="match_parent" android:minHeight="0dp" android:maxHeight="64dp"
                        android:max="10000" android:progress="1" android:progressDrawable="@drawable/widget_seek" />
                </FrameLayout>
                <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="4" />
                <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="34">
                    <TextView android:id="@+id/w_pos" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="start|center_vertical"
                        android:text="0:00" android:textColor="#FFA6A4B6" android:textSize="11sp" android:maxLines="1"
                        android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="16sp" android:autoSizeStepGranularity="1sp" />
                    <TextView android:id="@+id/w_dur" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="end|center_vertical"
                        android:text="0:00" android:textColor="#FFA6A4B6" android:textSize="11sp" android:maxLines="1"
                        android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="16sp" android:autoSizeStepGranularity="1sp" />
                </FrameLayout>
                <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="2" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="164" android:orientation="horizontal" android:baselineAligned="false">
                    <ImageView android:id="@+id/w_prev" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="133"
                        android:scaleType="fitStart" android:src="@drawable/ic_wn_prev" android:contentDescription="Previous song" />
                    <ImageView android:id="@+id/w_play" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="191"
                        android:scaleType="fitCenter" android:src="@drawable/ic_wn_play" android:contentDescription="Play or pause" />
                    <ImageView android:id="@+id/w_next" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="133"
                        android:scaleType="fitEnd" android:src="@drawable/ic_wn_next" android:contentDescription="Next song" />
                </LinearLayout>
                <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="10" />
            </LinearLayout>
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="19" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="60">
            <ImageView android:id="@+id/w_shuf" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_gravity="start"
                android:adjustViewBounds="true" android:scaleType="fitStart" android:paddingStart="5dp" android:paddingEnd="14dp"
                android:src="@drawable/ic_wn_shuf_off" android:contentDescription="Shuffle" />
            <ImageView android:id="@+id/w_rep" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_gravity="end"
                android:adjustViewBounds="true" android:scaleType="fitEnd" android:paddingStart="14dp" android:paddingEnd="3dp"
                android:src="@drawable/ic_wn_rep_off" android:contentDescription="Repeat" />
        </FrameLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="24" />
    </LinearLayout>
</FrameLayout>
