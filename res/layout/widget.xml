<?xml version="1.0" encoding="utf-8"?>
<!-- MY MUSIC widget: picture, song, previous / play / next -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_bg"
    android:padding="10dp">

    <ImageView
        android:id="@+id/w_art"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:scaleType="centerCrop"
        android:src="@mipmap/ic_launcher_fg"
        android:contentDescription="Open MY MUSIC" />

    <LinearLayout
        android:id="@+id/w_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingLeft="10dp"
        android:paddingRight="4dp">

        <TextView
            android:id="@+id/w_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MY MUSIC"
            android:textColor="#FFF2EEFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/w_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap play to start"
            android:textColor="#FF9C95B9"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/w_shuf"
        android:layout_width="34dp"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_w_shuf_off"
        android:contentDescription="Shuffle" />

    <ImageButton
        android:id="@+id/w_prev"
        android:layout_width="36dp"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_w_prev"
        android:contentDescription="Previous song" />

    <ImageButton
        android:id="@+id/w_play"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="2dp"
        android:background="@drawable/widget_play_bg"
        android:src="@drawable/ic_w_play"
        android:contentDescription="Play or pause" />

    <ImageButton
        android:id="@+id/w_next"
        android:layout_width="36dp"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_w_next"
        android:contentDescription="Next song" />

    <ImageButton
        android:id="@+id/w_rep"
        android:layout_width="34dp"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_w_rep_off"
        android:contentDescription="Repeat" />
</LinearLayout>
